includes:
    - ../../canvural/larastan-strict-rules/rules.neon

parameters:
    larastanStrictRules:
        allRules: false
        noFacade: true
        noValidationInController: true
        scopeShouldReturnQueryBuilder: true
        noPropertyAccessor: true
        noGlobalLaravelFunction: true
    allowedGlobalFunctions:
        - class_basename
        - class_uses_recursive
        - e
        - env
        - object_get
        - preg_replace_array
        - retry
        - str
        - tap
        - throw_if
        - throw_unless
        - trait_uses_recursive
        - with
        - collect
        - data_fill
        - data_get
        - data_set
        - value
        - config
        - fake
        - method_field
        - now
        - old
        - redirect
        - response
        - route
        - trans
        - trans_choice
        - __
        - view
        - url
        - secure_url
        - asset
        - secure_asset
