{
    "name": "worksome/coding-style",
    "description": "Worksomes coding style",
    "type": "composer-plugin",
    "require": {
        "php": "^8.4",
        "composer-plugin-api": "^2.0",
        "laravel/pao": "^1.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-mockery": "^2.0",
        "rector/rector": "^2.8.1",
        "slevomat/coding-standard": "^8.31",
        "spaze/phpstan-disallowed-calls": "^4.15",
        "symplify/easy-coding-standard": "^13.3"
    },
    "require-dev": {
        "canvural/larastan-strict-rules": "^3.0",
        "composer/composer": "^2.10",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "larastan/larastan": "^3.10",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "suggest": {
        "canvural/larastan-strict-rules": "Required for the Larastan strict rules in Laravel projects.",
        "larastan/larastan": "Required for the Laravel PHPStan rules in Laravel projects."
    },
    "conflict": {
        "canvural/larastan-strict-rules": "<3.0",
        "larastan/larastan": "<3.10",
        "squizlabs/php_codesniffer": ">= 5"
    },
    "autoload": {
        "psr-4": {
            "Worksome\\CodingStyle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Worksome\\CodingStyle\\Tests\\": "tests/"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Oliver Nybroe",
            "email": "oliver@worksome.com"
        },
        {
            "name": "Owen Voke",
            "email": "owen@worksome.com"
        },
        {
            "name": "Odinn Adalsteinsson",
            "email": "odinn.adalsteinsson@worksome.com"
        }
    ],
    "extra": {
        "class": "Worksome\\CodingStyle\\Plugin",
        "phpstan": {
            "includes": [
                "extension.php"
            ]
        },
        "phpstan/extension-installer": {
            "ignore": [
                "canvural/larastan-strict-rules",
                "larastan/larastan"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "ecs --fix",
        "test:style": "ecs",
        "test:phpstan": "pest --testsuite phpstan",
        "test:rector": "pest --testsuite rector",
        "test:phpcsfixer": "pest --testsuite phpcsfixer",
        "test:phpcs": "pest --testsuite phpcs",
        "test": [
            "@test:phpstan",
            "@test:rector",
            "@test:phpcsfixer",
            "@test:phpcs"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
